{
    "name": "tobento/service-translation",
    "version": "2.0",
    "type": "library",
    "description": "Allowing you to support multiple languages within your application.",
    "keywords": [
        "tobento",
        "package",
        "translations"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-dir": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Translation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Translation\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}